{
  "expo": {
    "name": "Zyora",
    "slug": "zyora",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "zyora",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.zyora.app"
    },
    "android": {
      "package": "com.zyora.app"
    },
    "web": {
      "bundler": "metro",
      "output": "static",
       "headers": {
        "Access-Control-Allow-Origin": "*",
        "Cross-Origin-Opener-Policy": "same-origin-allow-popups"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "Zyora needs access to your photos for virtual try-on",
          "cameraPermission": "Zyora needs access to your camera to take photos"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "Zyora needs access to save generated looks to your gallery",
          "savePhotosPermission": "Zyora needs permission to save photos",
          "isAccessMediaLocationEnabled": true
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/icon.png",
          "color": "#000000",
          "sounds": []
        }
      ],
      "expo-font",
      "expo-web-browser"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
